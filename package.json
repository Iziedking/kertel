{
  "name": "telt",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first Binance trading agent for Agent OS. Researches with bounded paid evidence, checks account and exchange rules, protects Spot holdings with isolated Futures hedges, and requires explicit confirmation before live execution.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/core",
    "packages/x402",
    "packages/providers",
    "apps/telt"
  ],
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "prove": "tsx scripts/prove.ts",
    "probe:providers": "tsx scripts/probe-providers.ts",
    "probe:adapters": "tsx scripts/probe-adapters.ts",
    "probe:futures": "tsx scripts/probe-futures.ts",
    "probe:spot": "tsx scripts/probe-spot.ts",
    "probe:watch": "tsx scripts/probe-watch.ts",
    "probe:scan": "tsx scripts/probe-scan.ts",
    "probe:proof": "tsx scripts/probe-proof.ts",
    "probe:model": "tsx scripts/probe-model.ts",
    "probe:openpulse": "tsx scripts/probe-openpulse.ts",
    "serve": "node apps/telt/dist/serve.js"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
