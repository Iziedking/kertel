# Telt environment. Names and comments only, never values.
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Every variable below is optional at boot. An unset variable turns its own
# feature off and says so in the health output; it does not take the process
# down. That is deliberate: a misspelled name should disable one pillar
# loudly, not kill the gateway at 3am.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------

# fixture | live
# fixture is the default and runs the entire product with no keys and no
# network. If this is unset, Telt is in fixture mode. Live mode additionally
# requires the keys below to be present and valid, or Telt refuses to leave
# fixture mode and reports why.
TELT_MODE=fixture

# Where SQLite state and rolling logs live. Restrict this directory to the
# operator. Defaults to ./data next to the repo.
#
# Storage is `node:sqlite`, which ships inside Node 22 and needs no native
# build. That is not a preference: OpenClaw installs plugin dependencies with
# `npm install --ignore-scripts`, so anything requiring a postinstall build step
# (better-sqlite3 among them) would not build on the operator's machine.
TELT_DATA_DIR=

# silent | error | warn | info | debug | trace
TELT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Owner
# ---------------------------------------------------------------------------

# The one WhatsApp identity allowed to command Telt, in E.164 form
# (+2348012345678). This must match channels.whatsapp.allowFrom in the OpenClaw
# config. Telt checks it again itself, because a channel allowlist is a
# routing convenience and not a security boundary.
TELT_OWNER_WHATSAPP=

# ---------------------------------------------------------------------------
# x402 research payments
# ---------------------------------------------------------------------------

# Private key of the wallet that pays for research data, 0x-prefixed hex.
#
# ONE KEY, ONE ADDRESS, TWO CHAINS. An EVM account has the same address on BNB
# Smart Chain and on Base, so this single key covers both rails. Fund that one
# address with:
#
#   - a few dollars of U on BNB Smart Chain
#     (0xcE24439F2D9C6a2289F741120FE202248B666666)
#     Pays CoinMarketCap and Nansen over Binance's own B402 rail.
#
#   - a few dollars of USDC on Base
#     (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
#     Pays CoinGecko and The Graph, which offer nothing else.
#
# No gas token is needed on either chain. x402 payments are gasless for the
# payer: the facilitator submits the transfer and pays the gas.
#
# BLAST RADIUS: this key can spend those two balances on the four allowlisted
# x402 endpoints, and nothing else. It has no Binance trading authority and
# cannot place an order or move funds off the wallet. Fund it with a few
# dollars and no more. If it leaks, move the remaining balance and generate a
# new key.
#
# It must NOT be the same key or identity as any Binance trading authority.
# Telt refuses to start in live mode if it detects the same secret in both
# places.
TELT_X402_PRIVATE_KEY=

# Which rail to prefer. Optional.
#
#   auto       (default) BSC U, then BSC USD1, then Base USDC. Prefers
#              Binance's B402 rail wherever the provider offers it.
#   bsc-only   refuse any provider that does not take U or USD1 on BSC.
#              CoinGecko and The Graph become unavailable.
#   base-only  force Base USDC everywhere. Works for all four providers today
#              and needs only one balance funded.
#
# Set this to exactly ONE of those three words. The BSC balance must hold U or
# USD1, not USDC: BSC USDC is permit2-only and Telt refuses it, so `auto`
# against a USDC-only BSC balance would refuse CoinMarketCap and Nansen rather
# than quietly fall back to Base.
TELT_X402_RAIL=auto

# Spend ceilings in US dollars, as plain decimal strings. Enforced by Telt's
# own policy engine against the SQLite ledger, not by the provider. They apply
# across both rails, since both are dollar stablecoins.
#
# Observed prices on 2026-09-07: CoinGecko, CoinMarketCap and The Graph charge
# $0.01 per call, Nansen Smart Money charges $0.05. The research planner buys
# the cheapest sufficient set, so a price check costs $0.01 and a full trade
# thesis costs $0.06. A $2.00 daily cap is roughly 33 full theses.
TELT_X402_MAX_PER_CALL_USDC=0.06
TELT_X402_MAX_PER_RUN_USDC=0.10
TELT_X402_MAX_PER_DAY_USDC=2.00

# RPC endpoints. Both optional; leave blank to use public endpoints. Set
# private ones if you hit rate limits during the demo.
TELT_BASE_RPC_URL=
TELT_BSC_RPC_URL=

# ---------------------------------------------------------------------------
# Binance Agent OS
# ---------------------------------------------------------------------------

# MCP endpoint, Streamable HTTP. Unverified against the live server as of
# 2026-09-07; confirm with the probe script before trusting it.
TELT_BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# THIS IS TELT'S PREFERRED EXECUTION PATH. Set it and orders go through
# Binance Agent OS into the Agentic sub-account.
#
# CORRECTION, 2026-09-07: an earlier version of this file said there was no
# bearer token to put here and told you to leave it unset. That was wrong. The
# Agent OS access token IS a plain bearer credential, it works with nothing but
# an Authorization header, and it lasts THIRTY DAYS.
#
# HOW TO GET IT. Connect the Binance MCP server to any supported client and
# complete the browser sign-in once:
#
#   claude mcp add binance-mcp-server --transport http https://agent.binance.com/mcp/agentic
#
# The client stores the token after you authorise. In Claude Code it lands in
# ~/.claude/.credentials.json under mcpOAuth, keyed by server name. Copy the
# accessToken value here.
#
# BLAST RADIUS, read from the live token on 2026-09-07. Granted scopes are
# mcp:account:read, mcp:spot:trade, mcp:margin:loan, mcp:futures:trade,
# mcp:wallet:transfer, mcp:master:read. THERE IS NO WITHDRAWAL SCOPE TO GRANT.
# That is a stronger guarantee than an API key with the withdrawal box
# unticked, because it is not a box anybody can later tick. Orders land in the
# Agentic sub-account, which starts empty; fund it at
# https://www.binance.com/en/my/sub-account/asset-management/transfer
#
# EXPIRY. Thirty days, and Binance advertises no refresh grant
# (grant_types_supported is ["authorization_code"] only), so it cannot renew
# itself. A server runs unattended for a month and then needs one browser
# sign-in. Telt says which rail it is on in telt_status, and refuses with
# EXECUTION_ADAPTER_UNAVAILABLE naming the expiry when the token lapses.
#
# If this is unset, Telt falls back to TELT_BINANCE_API_KEY below.
TELT_BINANCE_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Binance Spot trading credentials
# ---------------------------------------------------------------------------

# THIS is what Telt trades through. Not the MCP server above.
#
# The MCP server authorises over OAuth with a browser redirect to a localhost
# callback, and the credential lands in whichever MCP client completed the flow.
# A long-running gateway cannot re-run a browser flow and cannot borrow another
# client's credential, so Telt uses an ordinary Binance API key instead.
#
# CREATE THE KEY LIKE THIS, in Binance > API Management:
#   - Enable Reading                     YES
#   - Enable Spot & Margin Trading       YES
#   - Enable Withdrawals                 NO   <- leave this off, always
#   - Restrict access to trusted IPs     recommended, if this host has a static IP
#
# BLAST RADIUS: read plus Spot trade. With withdrawals off, the worst case of a
# full compromise is bad trades inside the account, not drained funds. Telt
# additionally caps every order at TELT_MAX_TRADE_NOTIONAL and refuses any
# symbol outside TELT_ALLOWED_SYMBOLS.
#
# Both must be set together, and neither may be the same secret as
# TELT_X402_PRIVATE_KEY: the research wallet spends cents on data and the
# exchange key can move the trading balance, so one leak must not be both.
# Telt refuses to start if they match.
TELT_BINANCE_API_KEY=
TELT_BINANCE_API_SECRET=

# ---------------------------------------------------------------------------
# Trading limits
# ---------------------------------------------------------------------------

# Which symbols Telt may propose, spot and futures.
#
# A comma-separated list restricts it to exactly those pairs. A single "*"
# allows anything Binance itself lists as TRADING, which is checked against the
# live exchangeInfo on every proposal rather than against a list kept here — so
# a delisted or halted pair is refused even if it once worked.
#
# "*" is the setting for a general trading agent, and it is not a loosening of
# the money limits: every order still passes TELT_MAX_TRADE_NOTIONAL, the
# daily loss ceiling, the slippage cap, and the confirmation code. What the
# list controls is which markets exist to Telt, not how much it may risk.
#
# Paid research providers are a separate matter. A symbol with no verified
# CoinGecko/CoinMarketCap/Nansen id still trades, but those providers refuse it
# by name on the receipt rather than guessing an id and pricing the wrong asset.
TELT_ALLOWED_SYMBOLS=*

# Hard ceiling on a single order, in quote currency. A proposal above this is
# refused, not clamped, so the user always sees the number they asked for
# rejected rather than quietly shrunk.
TELT_MAX_TRADE_NOTIONAL=25

# Realised loss ceiling per UTC day, in quote currency. Once crossed, Telt
# refuses new proposals until the next UTC day or an explicit resume.
TELT_MAX_DAILY_LOSS=50

# Maximum tolerated slippage, in basis points. 50 is 0.5 percent.
TELT_MAX_SLIPPAGE_BPS=50

# How long a trade proposal and its confirmation token stay valid. Seconds, not
# hours: the price behind the proposal goes stale fast.
TELT_PROPOSAL_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Futures limits (USDⓈ-M)
# ---------------------------------------------------------------------------
#
# Futures needs its own two limits because the spot ones do not bound it.
# Leverage means a small margin controls a large position, so a 25 USDT
# per-trade cap does not stop a 500 USDT position from existing.
#
# Futures is available only on the Agent OS rail (TELT_BINANCE_MCP_TOKEN).
# On the API-key rail these two settings are read and ignored, and every
# futures tool answers that futures is unavailable.

# Highest leverage Telt will open at. Must be 1 to 20; the default is 3.
# Binance's own default for ETHUSDT is 20x on cross margin, where a 5 percent
# move is the entire margin and the whole futures wallet backs the position.
# Telt sets isolated margin and this leverage before it opens anything, and
# refuses to open if either could not be set.
TELT_MAX_LEVERAGE=3

# Ceiling on the POSITION, in quote currency, not on the margin behind it.
# At 3x, a 50 position is about 17 of margin. Default 50.
# Note Binance's own floor: ETHUSDT futures will not accept a position under
# 20 USDT, so anything below that is refused by the exchange, not by Telt.
TELT_MAX_FUTURES_NOTIONAL=50

# The live write gate. Must be exactly "true" for Telt to place a real order.
# Unset or "false" means every execution is refused after full policy
# evaluation, so the refusal path stays testable without risking funds.
#
# Any other value is a startup error, not a quiet "off". Somebody who wrote
# "yes" or "1" believes trading is enabled, and the gap between that belief and
# the truth is the whole risk this flag exists to manage.
TELT_LIVE_EXECUTION=false

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# The model writes the thesis and nothing else. It never chooses an endpoint,
# an amount, a symbol, or whether to execute. If this is unset, research still
# runs and returns evidence with an explicit "no thesis available" state.
ANTHROPIC_API_KEY=
TELT_MODEL=claude-sonnet-5
