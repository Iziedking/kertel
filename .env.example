# Kertel environment. Names and comments only, never values.
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Every variable below is optional at boot. An unset variable turns its own
# feature off and says so in the health output; it does not take the process
# down. That is deliberate: a misspelled name should disable one pillar
# loudly, not kill the gateway at 3am.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------

# fixture | live
# fixture is the default and runs the entire product with no keys and no
# network. If this is unset, Kertel is in fixture mode. Live mode additionally
# requires the keys below to be present and valid, or Kertel refuses to leave
# fixture mode and reports why.
KERTEL_MODE=fixture

# Where SQLite state and rolling logs live. Restrict this directory to the
# operator. Defaults to ./data next to the repo.
#
# Storage is `node:sqlite`, which ships inside Node 22 and needs no native
# build. That is not a preference: OpenClaw installs plugin dependencies with
# `npm install --ignore-scripts`, so anything requiring a postinstall build step
# (better-sqlite3 among them) would not build on the operator's machine.
KERTEL_DATA_DIR=

# silent | error | warn | info | debug | trace
KERTEL_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Owner
# ---------------------------------------------------------------------------

# The one WhatsApp identity allowed to command Kertel, in E.164 form
# (+2348012345678). This must match channels.whatsapp.allowFrom in the OpenClaw
# config. Kertel checks it again itself, because a channel allowlist is a
# routing convenience and not a security boundary.
KERTEL_OWNER_WHATSAPP=

# ---------------------------------------------------------------------------
# x402 research payments
# ---------------------------------------------------------------------------

# Private key of the wallet that pays for research data, 0x-prefixed hex.
#
# ONE KEY, ONE ADDRESS, TWO CHAINS. An EVM account has the same address on BNB
# Smart Chain and on Base, so this single key covers both rails. Fund that one
# address with:
#
#   - a few dollars of U on BNB Smart Chain
#     (0xcE24439F2D9C6a2289F741120FE202248B666666)
#     Pays CoinMarketCap and Nansen over Binance's own B402 rail.
#
#   - a few dollars of USDC on Base
#     (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
#     Pays CoinGecko and The Graph, which offer nothing else.
#
# No gas token is needed on either chain. x402 payments are gasless for the
# payer: the facilitator submits the transfer and pays the gas.
#
# BLAST RADIUS: this key can spend those two balances on the four allowlisted
# x402 endpoints, and nothing else. It has no Binance trading authority and
# cannot place an order or move funds off the wallet. Fund it with a few
# dollars and no more. If it leaks, move the remaining balance and generate a
# new key.
#
# It must NOT be the same key or identity as any Binance trading authority.
# Kertel refuses to start in live mode if it detects the same secret in both
# places.
KERTEL_X402_PRIVATE_KEY=

# Which rail to prefer. Optional.
#
#   auto       (default) BSC U, then BSC USD1, then Base USDC. Prefers
#              Binance's B402 rail wherever the provider offers it.
#   bsc-only   refuse any provider that does not take U or USD1 on BSC.
#              CoinGecko and The Graph become unavailable.
#   base-only  force Base USDC everywhere. Works for all four providers today
#              and needs only one balance funded.
#
# Set this to exactly ONE of those three words. The BSC balance must hold U or
# USD1, not USDC: BSC USDC is permit2-only and Kertel refuses it, so `auto`
# against a USDC-only BSC balance would refuse CoinMarketCap and Nansen rather
# than quietly fall back to Base.
KERTEL_X402_RAIL=auto

# Spend ceilings in US dollars, as plain decimal strings. Enforced by Kertel's
# own policy engine against the SQLite ledger, not by the provider. They apply
# across both rails, since both are dollar stablecoins.
#
# Observed prices on 2026-09-07: CoinGecko, CoinMarketCap and The Graph charge
# $0.01 per call, Nansen Smart Money charges $0.05. The research planner buys
# the cheapest sufficient set, so a price check costs $0.01 and a full trade
# thesis costs $0.06. A $2.00 daily cap is roughly 33 full theses.
KERTEL_X402_MAX_PER_CALL_USDC=0.06
KERTEL_X402_MAX_PER_RUN_USDC=0.10
KERTEL_X402_MAX_PER_DAY_USDC=2.00

# RPC endpoints. Both optional; leave blank to use public endpoints. Set
# private ones if you hit rate limits during the demo.
KERTEL_BASE_RPC_URL=
KERTEL_BSC_RPC_URL=

# ---------------------------------------------------------------------------
# Binance Agent OS
# ---------------------------------------------------------------------------

# MCP endpoint, Streamable HTTP. Unverified against the live server as of
# 2026-09-07; confirm with the probe script before trusting it.
KERTEL_BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# VERIFIED 2026-09-07: there is no bearer token to put here. The Binance Agent
# OS MCP server authorises over OAuth (PKCE, browser redirect to a localhost
# callback), and the credential lives in the MCP client's own store, not in an
# environment variable. Leave this unset; it exists only so an operator reading
# this file learns that, rather than going looking for a token that does not
# exist.
#
# BLAST RADIUS, read from the live server on 2026-09-07 via
# wallet_getApiKeyPermission: enableReading true, enableSpotAndMarginTrading
# true, enableWithdrawals FALSE, enableInternalTransfer false. So the worst case
# of a full compromise of this rail is bad trades, not drained funds. The OAuth
# login lands in a Binance SUB-ACCOUNT, which starts unfunded; move funds to it
# deliberately at
# https://www.binance.com/en/my/sub-account/asset-management/transfer
# If it is compromised: stop trading, revoke the authorisation in Binance, and
# reconcile every open operation.
KERTEL_BINANCE_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Binance Spot trading credentials
# ---------------------------------------------------------------------------

# THIS is what Kertel trades through. Not the MCP server above.
#
# The MCP server authorises over OAuth with a browser redirect to a localhost
# callback, and the credential lands in whichever MCP client completed the flow.
# A long-running gateway cannot re-run a browser flow and cannot borrow another
# client's credential, so Kertel uses an ordinary Binance API key instead.
#
# CREATE THE KEY LIKE THIS, in Binance > API Management:
#   - Enable Reading                     YES
#   - Enable Spot & Margin Trading       YES
#   - Enable Withdrawals                 NO   <- leave this off, always
#   - Restrict access to trusted IPs     recommended, if this host has a static IP
#
# BLAST RADIUS: read plus Spot trade. With withdrawals off, the worst case of a
# full compromise is bad trades inside the account, not drained funds. Kertel
# additionally caps every order at KERTEL_MAX_TRADE_NOTIONAL and refuses any
# symbol outside KERTEL_ALLOWED_SYMBOLS.
#
# Both must be set together, and neither may be the same secret as
# KERTEL_X402_PRIVATE_KEY: the research wallet spends cents on data and the
# exchange key can move the trading balance, so one leak must not be both.
# Kertel refuses to start if they match.
KERTEL_BINANCE_API_KEY=
KERTEL_BINANCE_API_SECRET=

# ---------------------------------------------------------------------------
# Trading limits
# ---------------------------------------------------------------------------

# Comma-separated Spot symbols Kertel may ever propose. Anything not listed here
# is refused before any provider is called. Start with one or two liquid pairs.
KERTEL_ALLOWED_SYMBOLS=ETHUSDT,BTCUSDT

# Hard ceiling on a single order, in quote currency. A proposal above this is
# refused, not clamped, so the user always sees the number they asked for
# rejected rather than quietly shrunk.
KERTEL_MAX_TRADE_NOTIONAL=25

# Realised loss ceiling per UTC day, in quote currency. Once crossed, Kertel
# refuses new proposals until the next UTC day or an explicit resume.
KERTEL_MAX_DAILY_LOSS=50

# Maximum tolerated slippage, in basis points. 50 is 0.5 percent.
KERTEL_MAX_SLIPPAGE_BPS=50

# How long a trade proposal and its confirmation token stay valid. Seconds, not
# hours: the price behind the proposal goes stale fast.
KERTEL_PROPOSAL_TTL_SECONDS=120

# The live write gate. Must be exactly "true" for Kertel to place a real order.
# Unset or "false" means every execution is refused after full policy
# evaluation, so the refusal path stays testable without risking funds.
#
# Any other value is a startup error, not a quiet "off". Somebody who wrote
# "yes" or "1" believes trading is enabled, and the gap between that belief and
# the truth is the whole risk this flag exists to manage.
KERTEL_LIVE_EXECUTION=false

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# The model writes the thesis and nothing else. It never chooses an endpoint,
# an amount, a symbol, or whether to execute. If this is unset, research still
# runs and returns evidence with an explicit "no thesis available" state.
ANTHROPIC_API_KEY=
KERTEL_MODEL=claude-sonnet-5
